# Дирижёр 0.3.0: доступ к новым программаторам без sudo (группа plugdev).
# Отдельный файл — основной 99-dirizher.rules (CH341A) не меняется.
# Установка:
#   sudo cp system/99-dirizher-tools.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   sudo usermod -aG plugdev,dialout $USER     (затем перелогиньтесь)
# Последовательные порты (/dev/ttyUSB*, /dev/ttyACM* — esptool, Bus Pirate 5, Arduino-as-ISP)
# доступны группе dialout, отдельные правила для них не нужны.
# ПРОВЕРИТЬ НА ЖЕЛЕЗЕ: сверьте VID:PID своих устройств командой lsusb.

# USBasp (avrdude)
SUBSYSTEM=="usb", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="05dc", MODE="0660", GROUP="plugdev"

# ST-Link V2 / V2-1 / V3 (probe-rs, OpenOCD)
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3748", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374b", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374e", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374f", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3753", MODE="0660", GROUP="plugdev"

# T48 / TL866II+ (minipro)
SUBSYSTEM=="usb", ATTRS{idVendor}=="a466", ATTRS{idProduct}=="0a53", MODE="0660", GROUP="plugdev"

# Логические анализаторы fx2lafw (sigrok-cli): клоны Saleae и прошивка sigrok
SUBSYSTEM=="usb", ATTRS{idVendor}=="0925", ATTRS{idProduct}=="3881", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="608c", MODE="0660", GROUP="plugdev"
